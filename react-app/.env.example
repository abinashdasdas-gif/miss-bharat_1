# Copy this file to ".env.local" and put your real key there.
# .env.local is git-ignored, so it never gets committed.
#
# ⚠️ IMPORTANT: VITE_ variables are baked into the built JS at "npm run build".
# Use this ONLY for LOCAL development (npm run dev).
# Do NOT build/deploy with a real key here, or it will be exposed publicly.
# For the live site, users enter their own key in the app (saved in their browser).

VITE_GEMINI_KEY=
VITE_GEMINI_MODEL=gemini-2.0-flash-preview-image-generation
